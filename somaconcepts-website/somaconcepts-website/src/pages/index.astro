---
import Base from '../layouts/Base.astro';
import HeroMark from '../components/HeroMark.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { company, services, process, testimonials } from '../data/site';
---
<Base description="Soma Concepts builds and runs mobile apps, websites, business automation, brand strategy and ads for growing businesses in Nigeria. Based in Abuja.">

  <!-- Hero: the one bold moment. The mark's bands lock together on load. -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1>We build and run the digital side of your business.</h1>
        <p class="lead">Apps, websites, automation and marketing for growing businesses in Nigeria. Made to work on day one, and still working years later.</p>
        <div class="btn-row">
          <a class="btn btn--primary" href="/contact/">Start a project</a>
          <a class="btn btn--outline" href="/work/">See our work</a>
        </div>
        <p class="proof">Based in {company.city}. {company.clientsServed} clients served since {company.founded}.</p>
      </div>
      <div class="hero-art cut-tl">
        <HeroMark />
        <svg class="hero-corner" viewBox="0 0 120 120" aria-hidden="true"><polygon points="120,0 120,120 0,120" fill="#1660D6" /></svg>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="section" aria-labelledby="services-heading">
    <div class="wrap">
      <div class="section-head">
        <h2 id="services-heading">What we do</h2>
        <p class="lead">Five services, one team. Use one, or let us handle the whole journey from first screen to first customer.</p>
      </div>
      <ul class="services">
        {services.map((s) => (
          <li>
            <Icon name={s.icon} size={36} />
            <div>
              <h3><a href={`/services/#${s.id}`}>{s.name}</a></h3>
              <p class="muted">{s.summary}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Featured case study -->
  <section class="section section--navy feature" aria-labelledby="airgo-heading">
    <div class="wrap feature-grid">
      <div class="feature-copy">
        <p class="kicker">Case study</p>
        <h2 id="airgo-heading">Airgo: one platform for stays, car hire, rides and deliveries</h2>
        <p class="lead">A Nigerian travel and logistics company wanted to take its business online. We designed and built the whole platform, and we still run it.</p>
        <a class="btn btn--primary" href="/work/">Read the Airgo case study</a>
      </div>
      <dl class="facts">
        <div><dt>3</dt><dd>Android apps: customers, hotel partners, drivers</dd></div>
        <div><dt>1</dt><dd>Customer website that matches the app</dd></div>
        <div><dt>Escrow</dt><dd>Payments held until the stay or car hire is delivered</dd></div>
        <div><dt>PIN</dt><dd>Every partner payout approved by staff before it leaves</dd></div>
      </dl>
    </div>
  </section>

  <!-- Process: a real sequence, so it is numbered -->
  <section class="section" aria-labelledby="process-heading">
    <div class="wrap">
      <div class="section-head">
        <h2 id="process-heading">How a project runs</h2>
        <p class="lead">Typical times for a website or a first app. Larger platforms take longer, and we agree the dates with you up front.</p>
      </div>
      <ol class="steps">
        {process.map((p, i) => (
          <li>
            <span class="step-num" aria-hidden="true">{i + 1}</span>
            <h3>{p.name}</h3>
            <p class="time">{p.time}</p>
            <p class="muted">{p.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Why us -->
  <section class="section section--mist" aria-labelledby="why-heading">
    <div class="wrap why-grid">
      <div class="section-head">
        <h2 id="why-heading">Why clients stay with us</h2>
        <p class="lead">Most agencies hand over a project and move on. We are set up to stay.</p>
      </div>
      <div class="why">
        <div>
          <h3>We run software, not only build it</h3>
          <p class="muted">We run our own products, so hosting, updates and real users are everyday work for us. That is what keeps your app working after launch.</p>
        </div>
        <div>
          <h3>One partner from build to growth</h3>
          <p class="muted">Your app, website, automation and ads come from one team, so nothing gets lost between a developer, a designer and a marketer.</p>
        </div>
        <div>
          <h3>We train our own engineers</h3>
          <p class="muted">Our Tech Talk academy in Abuja and Kaduna gives us a steady pipeline of skilled people, so your project is never short of hands.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="section" aria-labelledby="clients-heading">
    <div class="wrap">
      <h2 id="clients-heading" class="clients-title">What clients say</h2>
      <div class="quotes">
        {testimonials.map((t) => (
          <figure>
            <blockquote><p>{t.quote}</p></blockquote>
            <figcaption><strong>{t.who}</strong><span>{t.role}</span></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  /* Hero */
  .hero { padding-block: 40px 64px; }
  @media (min-width: 900px) { .hero { padding-block: 72px 96px; } }
  .hero-grid { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 900px) { .hero-grid { grid-template-columns: 1.15fr 1fr; gap: 64px; } }
  .hero-copy { display: grid; gap: 24px; }
  .hero h1 { max-width: 14ch; }
  .proof { color: var(--slate); font-size: var(--step--1); display: flex; align-items: center; gap: 10px; }
  .proof::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--cyan); flex: none; }
  .hero-art { --cut: 64px; position: relative; background: var(--navy); aspect-ratio: 1 / 1; display: grid; place-items: center; padding: 18%; max-width: 520px; width: 100%; justify-self: center; }
  .hero-corner { position: absolute; right: 0; bottom: 0; width: 22%; height: auto; }

  /* Services */
  .services { list-style: none; margin: 0; padding: 0; display: grid; border-top: 1px solid var(--hairline); }
  @media (min-width: 800px) { .services { grid-template-columns: 1fr 1fr; column-gap: 64px; } }
  .services li { display: grid; grid-template-columns: 36px 1fr; gap: 20px; padding-block: 28px; border-bottom: 1px solid var(--hairline); }
  .services h3 { margin-bottom: 6px; }
  .services h3 a { color: var(--ink); text-decoration: none; }
  .services h3 a:hover { color: var(--blue); text-decoration: underline; }

  /* Feature */
  .feature { position: relative; overflow: hidden; }
  .feature-grid { display: grid; gap: 48px; align-items: center; }
  @media (min-width: 900px) { .feature-grid { grid-template-columns: 1.2fr 1fr; gap: 80px; } }
  .feature-copy { display: grid; gap: 20px; justify-items: start; }
  .kicker { color: var(--cyan); font-weight: 600; }
  .facts { margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: #24426E; }
  .facts div { background: var(--navy); padding: 24px 20px 24px 0; }
  .facts div:nth-child(even) { padding-left: 20px; }
  .facts dt { font-family: var(--font-display); font-weight: 700; font-size: var(--step-3); color: var(--white); line-height: 1.1; margin-bottom: 8px; }
  .facts dd { margin: 0; color: var(--on-dark-muted); font-size: var(--step--1); }

  /* Steps */
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 32px; }
  @media (min-width: 700px) { .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1100px) { .steps { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 40px; } }
  .steps li { display: grid; gap: 8px; align-content: start; border-top: 2px solid var(--navy); padding-top: 20px; }
  .step-num { font-family: var(--font-display); font-weight: 700; font-size: var(--step-3); color: var(--blue); line-height: 1; }
  .time { font-size: var(--step--1); font-weight: 600; color: var(--navy); }

  /* Why */
  .why-grid .section-head { margin-bottom: 40px; }
  .why { display: grid; gap: 32px; }
  @media (min-width: 900px) { .why { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 48px; } }
  .why h3 { margin-bottom: 10px; }

  /* Quotes */
  .clients-title { margin-bottom: 40px; }
  .quotes { display: grid; gap: 24px; }
  @media (min-width: 900px) { .quotes { grid-template-columns: 1fr 1fr; gap: 40px; } }
  figure { margin: 0; padding: 32px; background: var(--mist); display: grid; gap: 20px; align-content: space-between; }
  figure:first-child { --cut: 32px; clip-path: polygon(var(--cut) 0, 100% 0, 100% 100%, 0 100%, 0 var(--cut)); }
  blockquote { margin: 0; font-size: var(--step-1); line-height: 1.55; }
  blockquote p::before { content: '“'; } blockquote p::after { content: '”'; }
  figcaption { display: grid; gap: 2px; font-size: var(--step--1); }
  figcaption span { color: var(--slate); }
</style>
