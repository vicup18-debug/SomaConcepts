---
// The Soma knot mark, drawn piece by piece so the bands can lock together on load.
import mark from '../data/mark.json';

interface Props { reversed?: boolean; animate?: boolean; class?: string }
const { reversed = true, animate = true, class: cls = '' } = Astro.props;

// Push each piece outward from the centre before it locks in.
function centroid(d: string) {
  const nums = d.match(/-?\d+(\.\d+)?/g)!.map(Number);
  let x = 0, y = 0, n = 0;
  for (let i = 0; i + 1 < nums.length; i += 2) { x += nums[i]; y += nums[i + 1]; n++; }
  return [x / n - 100, y / n - 100];
}
const push = (d: string, k = 0.55) => {
  const [x, y] = centroid(d);
  return `--dx:${(x * k).toFixed(1)}px;--dy:${(y * k).toFixed(1)}px`;
};
const silver = reversed ? '#C9D2DE' : '#8E9AAB';
const blue = reversed ? '#4F8FF5' : '#1660D6';
---
<svg class={`mark ${animate ? 'mark--animate' : ''} ${cls}`} viewBox="0 0 200 200" role="img" aria-label="Soma Concepts mark">
  {mark.blue.map((d: string, i: number) => <path class="piece piece--blue" d={d} fill={blue} style={`${push(d, 0.35)};--i:${i}`} />)}
  {mark.silver.map((d: string, i: number) => <path class="piece piece--silver" d={d} fill={silver} style={`${push(d)};--i:${i}`} />)}
  {mark.nodes.map(([cx, cy]: number[], i: number) => <circle class="node" cx={cx} cy={cy} r={mark.node_r} fill="#2BB3F0" style={`--i:${i}`} />)}
</svg>

<style>
  .mark { width: 100%; height: auto; overflow: visible; }
  @media (prefers-reduced-motion: no-preference) {
    .mark--animate .piece {
      animation: lock 900ms cubic-bezier(.2, .7, .1, 1) both;
      animation-delay: calc(150ms + var(--i) * 70ms);
    }
    .mark--animate .piece--blue { animation-delay: calc(350ms + var(--i) * 70ms); }
    .mark--animate .node {
      transform-box: fill-box; transform-origin: center;
      animation: node 400ms ease-out both;
      animation-delay: calc(1050ms + var(--i) * 80ms);
    }
  }
  @keyframes lock {
    from { transform: translate(var(--dx), var(--dy)); opacity: 0; }
    to { transform: translate(0, 0); opacity: 1; }
  }
  @keyframes node {
    from { transform: scale(0); }
    to { transform: scale(1); }
  }
</style>
