---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: ImageMetadata; alt: string; width?: number; tilt?: number; glow?: boolean; eager?: boolean }
const { src, alt, width = 320, tilt = 0, glow = false, eager = false } = Astro.props;
---
<div class:list={['phone', { glow }]} style={`transform: rotate(${tilt}deg)`}>
  <div class="screen">
    <Image src={src} alt={alt} width={width} quality={80} loading={eager ? 'eager' : 'lazy'} />
  </div>
</div>

<style>
  .phone { border-radius: 30px; padding: 7px; background: #0A1424; border: 1px solid rgba(255, 255, 255, 0.2); box-shadow: 0 30px 70px rgba(0, 0, 0, 0.55); }
  .phone.glow { border-color: rgba(43, 179, 240, 0.55); box-shadow: 0 30px 70px rgba(0, 0, 0, 0.6), 0 0 50px rgba(43, 179, 240, 0.3); }
  .screen { overflow: hidden; border-radius: 24px; aspect-ratio: 9 / 19; background: #000; }
  .screen :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: top; }
</style>
