---
import { company, whatsappLink } from '../data/site';
interface Props { heading?: string; text?: string }
const {
  heading = 'Tell us what you need to build.',
  text = 'Send a few lines about your business on WhatsApp. We reply within one working day with next steps.',
} = Astro.props;
---
<section class="cta" aria-labelledby="cta-heading">
  <div class="wrap">
    <div class="panel">
      <div class="glow breathe" aria-hidden="true"></div>
      <div class="copy">
        <h2 id="cta-heading">{heading}</h2>
        <p>{text}</p>
      </div>
      <div class="btn-row">
        <a class="btn btn--primary" href={whatsappLink()}>Chat on WhatsApp <span aria-hidden="true">→</span></a>
        <a class="btn btn--outline" href={`tel:${company.phoneIntl}`}>Call {company.phoneDisplay}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta { padding-block: var(--space-16) var(--space-24); }
  .panel {
    position: relative; overflow: hidden; isolation: isolate;
    display: grid; gap: 32px; align-items: center;
    padding: 48px 28px; border-radius: var(--radius-lg);
    background: linear-gradient(135deg, #0F2F63, #0A1D3C 60%);
    border: 1px solid rgba(120, 170, 255, 0.3);
    box-shadow: 0 30px 90px rgba(22, 96, 214, 0.25);
  }
  @media (min-width: 700px) { .panel { padding: 64px 56px; } }
  @media (min-width: 960px) { .panel { grid-template-columns: 1.4fr 1fr; } .btn-row { justify-content: flex-end; } }
  .glow { right: -12%; top: -70%; width: 60%; height: 220%; z-index: -1; background: radial-gradient(closest-side, rgba(43, 179, 240, 0.35), rgba(6, 21, 46, 0)); }
  .copy { display: grid; gap: 14px; }
  h2 { font-size: var(--step-4); }
  p { color: var(--muted); max-width: 52ch; font-size: var(--step-1); }
</style>
