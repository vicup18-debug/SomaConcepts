---
// Brand line icons: 24px grid, 2px stroke, square ends, 45-degree angles, one cyan node.
interface Props { name: string; size?: number; dark?: boolean }
const { name, size = 32, dark = false } = Astro.props;

const icons: Record<string, [string, [number, number] | null]> = {
  'mobile-app': ['<path d="M7 3H17V21H7Z"/><path d="M10 6H14"/>', [12, 17.5]],
  web: ['<path d="M3 5H21V19H3Z"/><path d="M3 9H21"/><path d="M10 12L8 14L10 16"/><path d="M14 12L16 14L14 16"/>', [6, 7]],
  automation: ['<path d="M4 10V6H17"/><path d="M14 3L17 6L14 9"/><path d="M20 14V18H7"/><path d="M10 15L7 18L10 21"/>', [12, 12]],
  'brand-strategy': ['<path d="M12 3L21 12L12 21L3 12Z"/><path d="M12 8L16 12L12 16L8 12Z"/>', [12, 12]],
  ads: ['<path d="M3 9H7L16 4V20L7 15H3Z"/><path d="M7 15L9 21H11"/>', [20, 12]],
  security: ['<path d="M12 3L20 6V12L12 21L4 12V6Z"/><path d="M8.5 12L11 14.5L15.5 10"/>', null],
  training: ['<path d="M2 9L12 4L22 9L12 14Z"/><path d="M6 11V16L12 19L18 16V11"/><path d="M22 9V13"/>', null],
  growth: ['<path d="M3 18L9 12L13 16L20 9"/><path d="M15 9H20V14"/>', [9, 12]],
  phone: ['<path d="M5 3H9L11 8L8.5 9.5C9.5 11.8 12.2 14.5 14.5 15.5L16 13L21 15V19C21 20 20 21 19 21C10.2 20.5 3.5 13.8 3 5C3 4 4 3 5 3Z"/>', null],
  mail: ['<path d="M3 5H21V19H3Z"/><path d="M3 5L12 13L21 5"/>', null],
  chat: ['<path d="M4 4H20V16H9L4 20Z"/>', [12, 10]],
  pin: ['<path d="M12 21L5.5 13.5A8 8 0 1 1 18.5 13.5Z"/>', [12, 9.5]],
};
const [body, node] = icons[name] ?? icons.web;
const stroke = dark ? '#FFFFFF' : '#0B2545';
---
<svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  <g fill="none" stroke={stroke} stroke-width="2" stroke-linecap="square" stroke-linejoin="miter" set:html={body} />
  {node && <circle cx={node[0]} cy={node[1]} r="1.75" fill="#2BB3F0" />}
</svg>
