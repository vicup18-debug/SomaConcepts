---
import { company, whatsappLink, services } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap grid">
    <div class="brand">
      <img src="/brand/soma-logo-horizontal-reversed.svg" alt="Soma Concepts" width="120" height="44" loading="lazy" />
      <p>We build and run the digital side of growing businesses. {company.tagline}</p>
    </div>

    <nav aria-label="Services">
      <h2>Services</h2>
      <ul>{services.map((s) => <li><a href={`/services/#${s.id}`}>{s.name}</a></li>)}</ul>
    </nav>

    <nav aria-label="Company">
      <h2>Company</h2>
      <ul>
        <li><a href="/work/">Work</a></li>
        <li><a href="/about/">About</a></li>
        <li><a href="/about/#tech-talk">Tech Talk academy</a></li>
        <li><a href="/contact/">Contact</a></li>
        <li><a href="/privacy/">Privacy</a></li>
      </ul>
    </nav>

    <div>
      <h2>Talk to us</h2>
      <ul>
        <li><a href={`tel:${company.phoneIntl}`}>{company.phoneDisplay}</a></li>
        <li><a href={whatsappLink()}>WhatsApp</a></li>
        <li><a href={`mailto:${company.email}`}>{company.email}</a></li>
        <li>{company.city}, {company.country}</li>
      </ul>
      <ul class="social">
        <li><a href={company.instagram}>Instagram</a></li>
        <li><a href={company.tiktok}>TikTok</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap legal">
    <p>© {year} {company.legalName}. {company.legalLine}.</p>
    <p>{company.tagline}</p>
  </div>
</footer>

<style>
  .site-footer { position: relative; overflow: hidden; background: #040C1C; border-top: 1px solid var(--line); color: var(--dim); padding-top: 64px; font-size: var(--step--1); }
  .grid { display: grid; gap: 40px; grid-template-columns: 1fr; }
  @media (min-width: 700px) { .grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1000px) { .grid { grid-template-columns: 1.6fr 1fr 1fr 1.2fr; } }
  .brand img { height: 40px; width: auto; margin-bottom: 20px; }
  .brand p { max-width: 34ch; font-size: var(--step-0); color: var(--muted); }
  h2 { font-family: var(--font-body); font-size: var(--step--1); font-weight: 600; color: #FFFFFF; margin-bottom: 14px; letter-spacing: 0; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  a { color: var(--dim); text-decoration: none; }
  a:hover { color: #FFFFFF; }
  .social { display: flex; gap: 20px; margin-top: 18px; }
  .legal { margin-top: 56px; padding-block: 24px 32px; border-top: 1px solid var(--line); display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
</style>
