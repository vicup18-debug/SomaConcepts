---
import { company, whatsappLink, services } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap grid">
    <div class="brand">
      <img src="/brand/soma-logo-horizontal-reversed.svg" alt="Soma Concepts" width="120" height="44" loading="lazy" />
      <p>We build and run the digital side of growing businesses. {company.tagline}</p>
    </div>

    <nav aria-label="Services">
      <h2>Services</h2>
      <ul>{services.map((s) => <li><a href={`/services/#${s.id}`}>{s.name}</a></li>)}</ul>
    </nav>

    <nav aria-label="Company">
      <h2>Company</h2>
      <ul>
        <li><a href="/work/">Work</a></li>
        <li><a href="/about/">About</a></li>
        <li><a href="/about/#tech-talk">Tech Talk academy</a></li>
        <li><a href="/contact/">Contact</a></li>
      </ul>
    </nav>

    <div>
      <h2>Talk to us</h2>
      <ul>
        <li><a href={`tel:${company.phoneIntl}`}>{company.phoneDisplay}</a></li>
        <li><a href={whatsappLink()}>WhatsApp</a></li>
        <li><a href={`mailto:${company.email}`}>{company.email}</a></li>
        <li>{company.city}, {company.country}</li>
      </ul>
      <ul class="social">
        <li><a href={company.instagram}>Instagram</a></li>
        <li><a href={company.tiktok}>TikTok</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap legal">
    <p>© {year} {company.legalName}. {company.legalLine}.</p>
  </div>
  <svg class="corner" width="96" height="96" viewBox="0 0 96 96" aria-hidden="true"><polygon points="96,0 96,96 0,96" fill="#1660D6" /></svg>
</footer>

<style>
  .site-footer { position: relative; overflow: hidden; background: var(--navy); color: var(--on-dark-muted); padding-top: var(--space-16); font-size: var(--step--1); }
  .grid { display: grid; gap: 40px; grid-template-columns: 1fr; }
  @media (min-width: 700px) { .grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1000px) { .grid { grid-template-columns: 1.6fr 1fr 1fr 1.2fr; } }
  .brand img { height: 44px; width: auto; margin-bottom: 20px; }
  .brand p { max-width: 34ch; font-size: var(--step-0); }
  h2 { font-family: var(--font-body); font-size: var(--step--1); font-weight: 600; color: var(--white); margin-bottom: 14px; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  a { color: var(--on-dark-muted); text-decoration: none; }
  a:hover { color: var(--white); text-decoration: underline; }
  .social { display: flex; gap: 20px; margin-top: 18px; }
  .legal { margin-top: var(--space-12); padding-block: 24px 32px; border-top: 1px solid #24426E; }
</style>
