---
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/', label: 'Home' },
  { href: '/services/', label: 'Services' },
  { href: '/work/', label: 'Work' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
const isCurrent = (href: string) => path === (href.replace(/\/$/, '') || '/');
---
<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="logo" aria-label="Soma Concepts, home">
      <img src="/brand/soma-logo-horizontal-reversed.svg" alt="Soma Concepts" width="109" height="40" />
    </a>

    <nav class="nav-desktop" aria-label="Main">
      <ul>
        {links.map((l) => (
          <li><a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>
    <a href="/contact/" class="btn btn--cyan cta-desktop">Start a project <span aria-hidden="true">→</span></a>

    <details class="nav-mobile">
      <summary aria-label="Menu">
        <span class="burger" aria-hidden="true"><span></span><span></span></span>
        <span class="summary-text">Menu</span>
      </summary>
      <nav aria-label="Main" class="sheet">
        <ul>
          {links.map((l) => (
            <li><a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a></li>
          ))}
        </ul>
        <a href="/contact/" class="btn btn--primary">Start a project</a>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: rgba(6, 21, 46, 0.72);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 24px; min-height: 76px; }
  .logo img { height: 40px; width: auto; }

  ul { list-style: none; margin: 0; padding: 0; }
  .nav-desktop { display: none; }
  .nav-desktop ul { display: flex; gap: 36px; }
  .nav-desktop a, .sheet li a { color: var(--muted); text-decoration: none; font-weight: 500; font-size: 15px; }
  .nav-desktop a { display: block; padding-block: 6px; border-bottom: 2px solid transparent; }
  .nav-desktop a:hover { color: var(--white); }
  .nav-desktop a[aria-current='page'] { color: var(--white); border-bottom-color: var(--cyan); }
  .cta-desktop { display: none; }

  .nav-mobile summary { list-style: none; display: flex; align-items: center; gap: 10px; min-height: 44px; padding: 0 4px; cursor: pointer; font-weight: 600; color: var(--white); }
  .nav-mobile summary::-webkit-details-marker { display: none; }
  .burger { display: grid; gap: 6px; width: 22px; }
  .burger span { display: block; height: 2px; background: var(--white); transition: transform 200ms ease; }
  .nav-mobile[open] .burger span:first-child { transform: translateY(4px) rotate(45deg); }
  .nav-mobile[open] .burger span:last-child { transform: translateY(-4px) rotate(-45deg); }
  .sheet { position: absolute; left: 0; right: 0; top: 100%; background: #081A36; border-bottom: 1px solid var(--line); padding: 8px 20px 24px; display: grid; gap: 16px; }
  .sheet li a { display: block; padding: 14px 0; border-bottom: 1px solid var(--line); font-size: var(--step-1); }
  .sheet li a[aria-current='page'] { color: var(--white); }

  @media (min-width: 960px) {
    .nav-desktop { display: block; }
    .cta-desktop { display: inline-flex; }
    .nav-mobile { display: none; }
  }
</style>
