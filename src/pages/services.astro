---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { services, process } from '../data/site';
---
<Base title="Services" description="Mobile apps, websites and web apps, business automation, brand strategy and ads management for growing businesses in Nigeria.">
  <section class="page-head">
    <div class="glow breathe" aria-hidden="true"></div>
    <div class="wrap">
      <p class="eyebrow">Services</p>
      <h1>Everything your business needs <span class="accent">to work online.</span></h1>
      <p class="lead">Pick one service, or let one team handle it end to end.</p>
      <nav class="jump" aria-label="Services on this page">
        {services.map((s) => <a href={`#${s.id}`}>{s.name}</a>)}
      </nav>
    </div>
  </section>

  <div class="wrap list">
    {services.map((s) => (
      <section id={s.id} class="service glass" aria-labelledby={`${s.id}-h`}>
        <div class="service-intro">
          <span class="icon"><Icon name={s.icon} size={30} /></span>
          <h2 id={`${s.id}-h`}>{s.name}</h2>
          <p class="lead">{s.summary}</p>
          <p class="for"><strong>Good fit for:</strong> {s.forWho}</p>
        </div>
        <div class="service-detail">
          <h3>What's included</h3>
          <ul class="nodes">{s.includes.map((x) => <li>{x}</li>)}</ul>
          <a class="btn btn--outline" href={`/contact/?service=${s.id}`}>Ask about {s.name.toLowerCase()} <span aria-hidden="true">→</span></a>
        </div>
      </section>
    ))}
  </div>

  <section class="section after" aria-labelledby="after-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">After launch, we stay</p>
        <h2 id="after-h">How a project runs</h2>
        <p class="lead">We host, update and maintain what we build, with one point of contact who knows your system.</p>
      </div>
      <ol class="steps">
        {process.map((p, i) => (
          <li class="glass">
            <span class="no">{String(i + 1).padStart(2, '0')}</span>
            <h3>{p.name}</h3>
            <span class="time">{p.time}</span>
            <p>{p.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .jump { display: flex; flex-wrap: wrap; gap: 8px 10px; margin-top: 8px; }
  .jump a { padding: 9px 16px; border: 1px solid var(--line); border-radius: 999px; color: var(--muted); text-decoration: none; font-size: var(--step--1); font-weight: 500; background: var(--glass); }
  .jump a:hover { border-color: var(--cyan); color: var(--white); }

  .list { display: grid; gap: 20px; }
  .service { scroll-margin-top: 96px; display: grid; gap: 32px; padding: 32px 24px; border-radius: var(--radius-lg); }
  @media (min-width: 700px) { .service { padding: 48px; } }
  @media (min-width: 960px) { .service { grid-template-columns: 1.2fr 1fr; gap: 64px; } }
  .service-intro { display: grid; gap: 16px; align-content: start; }
  .icon { width: 60px; height: 60px; border-radius: 50%; display: grid; place-items: center; background: rgba(22, 96, 214, 0.35); box-shadow: inset 0 0 0 1px rgba(79, 143, 245, 0.6), 0 0 40px rgba(22, 96, 214, 0.35); }
  .service h2 { font-size: var(--step-3); }
  .for { max-width: 56ch; color: var(--muted); }
  .for strong { color: var(--white); }
  .service-detail { display: grid; gap: 20px; align-content: start; justify-items: start; }
  .service-detail h3 { font-size: var(--step-1); }

  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); }
  .steps li { padding: 28px 24px; border-radius: var(--radius); display: grid; gap: 8px; align-content: start; }
  .no { font-family: var(--font-display); font-weight: 700; font-size: 1.5rem; color: var(--blue-light); }
  .time { color: var(--cyan); font-size: var(--step--1); font-weight: 600; }
  .steps p { color: var(--muted); font-size: 0.9375rem; }
</style>
