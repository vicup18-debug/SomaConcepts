---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { services, process } from '../data/site';
---
<Base title="Services" description="Mobile apps, websites and web apps, business automation, brand strategy and ads management for growing businesses in Nigeria.">
  <section class="page-head">
    <div class="wrap">
      <h1>Services</h1>
      <p class="lead">Everything a growing business needs to work online, from one team. Pick one service, or let us handle it end to end.</p>
      <nav class="jump" aria-label="Services on this page">
        {services.map((s) => <a href={`#${s.id}`}>{s.name}</a>)}
      </nav>
    </div>
  </section>

  {services.map((s, i) => (
    <section id={s.id} class={`section service ${i % 2 ? 'section--mist' : ''}`} aria-labelledby={`${s.id}-h`}>
      <div class="wrap service-grid">
        <div class="service-intro">
          <Icon name={s.icon} size={48} />
          <h2 id={`${s.id}-h`}>{s.name}</h2>
          <p class="lead">{s.summary}</p>
          <p class="for"><strong>Good fit for:</strong> {s.forWho}</p>
        </div>
        <div>
          <h3>What's included</h3>
          <ul class="nodes">{s.includes.map((x) => <li>{x}</li>)}</ul>
          <a class="btn btn--outline" href={`/contact/?service=${s.id}`}>Ask about {s.name.toLowerCase()}</a>
        </div>
      </div>
    </section>
  ))}

  <section class="section section--navy" aria-labelledby="after-h">
    <div class="wrap after">
      <h2 id="after-h">After launch, we stay</h2>
      <p class="lead">We can host, update and maintain what we build, with one point of contact who knows your system.</p>
      <ol class="mini-steps">
        {process.map((p) => <li><strong>{p.name}</strong><span>{p.time}</span></li>)}
      </ol>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .page-head { padding-block: 56px 48px; border-bottom: 1px solid var(--hairline); }
  .page-head .wrap { display: grid; gap: 20px; }
  .jump { display: flex; flex-wrap: wrap; gap: 8px 12px; margin-top: 8px; }
  .jump a { padding: 8px 14px; border: 1px solid var(--hairline); border-radius: var(--radius-sm); color: var(--ink); text-decoration: none; font-size: var(--step--1); font-weight: 500; }
  .jump a:hover { border-color: var(--blue); color: var(--blue); }

  .service { scroll-margin-top: 80px; }
  .service-grid { display: grid; gap: 40px; }
  @media (min-width: 900px) { .service-grid { grid-template-columns: 1.2fr 1fr; gap: 80px; } }
  .service-intro { display: grid; gap: 18px; align-content: start; }
  .for { max-width: 56ch; }
  .service-grid > div:last-child { display: grid; gap: 20px; align-content: start; justify-items: start; }

  .after { display: grid; gap: 20px; }
  .mini-steps { list-style: none; padding: 0; margin: 24px 0 0; display: grid; gap: 1px; background: #24426E; grid-template-columns: 1fr; }
  @media (min-width: 700px) { .mini-steps { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .mini-steps li { background: var(--navy); padding: 18px 20px 18px 0; display: grid; gap: 4px; counter-increment: step; }
  @media (min-width: 700px) { .mini-steps li + li { padding-left: 20px; } }
  .mini-steps strong { color: var(--white); font-family: var(--font-display); font-size: var(--step-2); font-weight: 600; }
  .mini-steps strong::before { content: counter(step) '. '; color: var(--blue-on-dark); }
  .mini-steps span { color: var(--on-dark-muted); font-size: var(--step--1); }
</style>
