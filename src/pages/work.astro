---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import CtaBand from '../components/CtaBand.astro';
import Phone from '../components/Phone.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { testimonials } from '../data/site';
import { projects } from '../data/projects';
import airgoPhone from '../assets/work/airgo-phone.jpg';

const parts = [
  { name: 'Airgo app', who: 'Customers', what: 'Book stays, request car hire, rides and deliveries, see nearby drivers on a map and track every booking.' },
  { name: 'Airgo website', who: 'Customers', what: 'The same booking experience on the web, rebuilt to match the app.' },
  { name: 'Airgo Stay', who: 'Hotel and apartment partners', what: 'List rooms, manage bookings and get paid soon after guests check in.' },
  { name: 'Airgo Drive', who: 'Drivers, car owners, dispatch riders', what: 'Receive ride and delivery requests. Car owners price each car-hire request.' },
  { name: 'Admin dashboard', who: 'Airgo staff', what: 'Approve partners, manage bookings and approve every payout with a PIN.' },
];
---
<Base title="Work" description="Live apps and websites built by Soma Concepts for Nigerian businesses, including the Airgo travel and logistics platform, Soluxe Homes, Nonimedia, Megavolt Energy and more.">
  <PageHead eyebrow="Our work" title="Live products, not mockups." lead="Every project here is running today for a real business. Open any of them and try it." />

  <section class="section" aria-label="All projects">
    <div class="wrap grid">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>

  <section id="airgo" class="section section--raised case" aria-labelledby="airgo-h">
    <div class="wrap case-head">
      <div class="case-copy">
        <p class="eyebrow">Case study</p>
        <h2 id="airgo-h">Airgo: one platform for stays, car hire, rides and deliveries</h2>
        <p class="lead">One platform where Nigerians book hotels and apartments, hire cars, request rides and send packages. We designed it, built it and run it.</p>
        <dl class="glance">
          <div><dt>Client</dt><dd>Airgo, a travel and logistics company backed by an established travel agency</dd></div>
          <div><dt>What we did</dt><dd>Product design, three mobile apps, customer website, admin dashboard, payments, launch planning</dd></div>
          <div><dt>Status</dt><dd>Rolling out on Google Play. Flight booking in development.</dd></div>
        </dl>
      </div>
      <div class="case-phone">
        <div class="orb breathe case-orb" aria-hidden="true"></div>
        <div class="float"><Phone src={airgoPhone} alt="Airgo app home screen" tilt={5} glow width={340} /></div>
      </div>
    </div>

    <div class="wrap two">
      <h3 class="side">The challenge</h3>
      <div class="prose">
        <p class="muted">Airgo's founder already ran a travel agency and wanted one platform for stays, car hire, rides and deliveries. Each service works differently, so the platform had to handle all of them without confusing customers or partners.</p>
        <ul class="nodes">
          <li><strong>Different payment models.</strong> Stays and car hire need money held until the service is delivered. Rides and deliveries are paid to drivers in cash or by transfer.</li>
          <li><strong>Three kinds of users.</strong> Customers, hotel and apartment owners, and drivers each need their own tools and payouts.</li>
          <li><strong>Trust.</strong> Customers need to know their money is safe; partners need to know they will be paid.</li>
          <li><strong>Nigerian realities.</strong> Cash and transfers, patchy connections and Android-first users.</li>
        </ul>
      </div>
    </div>

    <div class="wrap two">
      <h3 class="side">What we built</h3>
      <div class="prose">
        <div class="table-wrap glass">
          <table>
            <thead><tr><th scope="col">Part</th><th scope="col">Used by</th><th scope="col">What it does</th></tr></thead>
            <tbody>
              {parts.map((p) => <tr><th scope="row">{p.name}</th><td>{p.who}</td><td>{p.what}</td></tr>)}
            </tbody>
          </table>
        </div>
        <ul class="nodes">
          <li><strong>Escrow payments</strong> for stays and car hire: customers pay up front, partners are paid once the service is delivered.</li>
          <li><strong>Bidding for car hire.</strong> Customers send a request, owners reply with a price, and the customer has an hour to accept.</li>
          <li><strong>Prepaid wallets</strong> for drivers and riders, so Airgo collects its commission automatically on each accepted job.</li>
          <li><strong>Safe payouts.</strong> No payout leaves without staff approval and a PIN.</li>
        </ul>
      </div>
    </div>

    <div class="wrap two">
      <h3 class="side">How we worked</h3>
      <ol class="how">
        <li><strong>Audit.</strong> We checked the existing site against leading booking platforms and fixed the critical issues first.</li>
        <li><strong>Design.</strong> We designed all three apps in Figma, so the client approved every screen before we built it.</li>
        <li><strong>Split the product.</strong> One app for everyone was too complex, so we made three focused apps on one shared backend.</li>
        <li><strong>Test on real phones.</strong> Every release is tested on Android devices before it goes to Google Play.</li>
        <li><strong>Stay on.</strong> We run the platform with the Airgo team and are now adding flight booking.</li>
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="more-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Clients</p>
        <h2 id="more-h">What clients say</h2>
      </div>
      <div class="quotes">
        {testimonials.map((t) => (
          <figure class="glass">
            <blockquote><p>{t.quote}</p></blockquote>
            <figcaption><strong>{t.who}</strong><span>{t.role}</span></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <CtaBand heading="Have a product like these in mind?" />
</Base>

<style>
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr)); gap: 20px; }

  .case { scroll-margin-top: 76px; display: grid; gap: 64px; overflow: hidden; }
  .case-head { display: grid; gap: 48px; align-items: center; }
  @media (min-width: 1000px) { .case-head { grid-template-columns: 1.4fr 1fr; } }
  .case-copy { display: grid; gap: 18px; }
  .case-phone { position: relative; width: 100%; max-width: 300px; justify-self: center; }
  .case-orb { left: 50%; top: 50%; width: 420px; height: 420px; margin: -210px 0 0 -210px; background: radial-gradient(closest-side, rgba(22, 96, 214, 0.7), rgba(22, 96, 214, 0.12) 70%, rgba(8, 26, 54, 0)); }
  .glance { margin: 12px 0 0; display: grid; gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: 14px; overflow: hidden; }
  @media (min-width: 800px) { .glance { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .glance div { background: var(--bg-2); padding: 18px 20px; }
  .glance dt { font-weight: 600; color: #FFFFFF; margin-bottom: 4px; }
  .glance dd { margin: 0; color: var(--muted); font-size: var(--step--1); }

  .two { display: grid; gap: 20px; }
  @media (min-width: 900px) { .two { grid-template-columns: 1fr 2.2fr; gap: 64px; } }
  .side { font-size: var(--step-3); font-weight: 700; }
  .prose { display: grid; gap: 24px; max-width: 76ch; }

  .table-wrap { overflow-x: auto; padding: 4px 20px; }
  table { width: 100%; border-collapse: collapse; min-width: 600px; }
  th, td { text-align: left; vertical-align: top; padding: 16px 16px 16px 0; border-bottom: 1px solid var(--line); }
  tbody tr:last-child th, tbody tr:last-child td { border-bottom: 0; }
  thead th { font-size: var(--step--1); color: var(--dim); font-weight: 600; }
  tbody th { font-family: var(--font-display); font-weight: 600; font-size: var(--step-1); white-space: nowrap; }
  td { color: var(--muted); }
  tbody td:nth-child(2) { width: 26%; }

  .how { margin: 0; padding-left: 1.4em; display: grid; gap: 16px; max-width: 70ch; color: var(--muted); }
  .how strong { color: #FFFFFF; }
  .how li::marker { font-family: var(--font-display); font-weight: 700; color: var(--blue-2); }

  .quotes { display: grid; gap: 20px; }
  @media (min-width: 900px) { .quotes { grid-template-columns: 1fr 1fr; } }
  figure { margin: 0; padding: 32px; display: grid; gap: 20px; align-content: space-between; }
  blockquote { margin: 0; font-size: var(--step-1); line-height: 1.6; }
  blockquote p::before { content: '“'; } blockquote p::after { content: '”'; }
  figcaption { display: grid; gap: 2px; font-size: var(--step--1); }
  figcaption span { color: var(--muted); }
</style>
