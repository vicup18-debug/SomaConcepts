---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PageHead from '../components/PageHead.astro';
import CtaBand from '../components/CtaBand.astro';
import { company } from '../data/site';
import victor from '../assets/team/victor-uzorchikwa.jpg';
import samuel from '../assets/team/samuel-ikediashi.jpg';
import gideon from '../assets/team/gideon-onuh.jpg';
import ebonom from '../assets/team/ebonom-agam.jpg';
import solak from '../assets/products/solak.png';
import smartWriter from '../assets/products/smart-writer.png';
import faithnow from '../assets/work/faithnow.jpg';

const team = [
  { name: 'Victor Uzorchikwa', role: 'Co-founder and CEO', img: victor },
  { name: 'Samuel Ikediashi', role: 'Co-founder and Creative Director', img: samuel },
  { name: 'Gideon Onuh', role: 'Human Resources', img: gideon },
  { name: 'Ebonom Agam, Esq.', role: 'Legal Partner', img: ebonom },
];

const promises = [
  { title: 'Clear, not clever', text: 'Plain words about what we will build, when, and what it costs.' },
  { title: 'Proof, not hype', text: 'We show work and results instead of adjectives.' },
  { title: 'Results, not jargon', text: 'We talk about what changes for your business, not the technology behind it.' },
  { title: 'Partners, not vendors', text: 'We stay after launch and keep improving what we built with you.' },
];
---
<Base title="About" description="Soma Concepts is an Abuja-based technology company that builds and runs the digital side of growing businesses. Meet the team, our products and the Tech Talk academy.">
  <PageHead eyebrow="About" title="A technology company from Abuja." lead={`${company.name} started in ${company.founded} to give growing Nigerian businesses one dependable partner for their apps, websites, automation and marketing. We have served ${company.clientsServed} clients so far, from real estate to travel, energy and events.`} />

  <section class="section" aria-labelledby="mark-h">
    <div class="wrap mark-grid">
      <div class="mark-art">
        <div class="orb breathe mark-orb" aria-hidden="true"></div>
        <img src="/brand/soma-logo-reversed.svg" alt="" width="320" height="99" />
      </div>
      <div class="prose">
        <p class="eyebrow">Our logo</p>
        <h2 id="mark-h">A name, and a full stop.</h2>
        <p class="lead">Our logo is our name, set bold and lowercase, closed with a dot. The dot is the full stop on every job: done properly, finished, built to last. It is also the point where the parts of a business connect: its apps, its website, its operations and its marketing.</p>
      </div>
    </div>
  </section>

  <section class="section section--raised" aria-labelledby="team-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">The team</p>
        <h2 id="team-h">The people behind Soma</h2>
        <p class="lead">A compact leadership team, backed by developers, designers, video editors and content creators.</p>
      </div>
      <ul class="team">
        {team.map((p) => (
          <li>
            <div class="photo-wrap"><Image src={p.img} alt={`Portrait of ${p.name}`} width={480} height={560} quality={78} class="photo" /></div>
            <h3>{p.name}</h3>
            <p class="muted">{p.role}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="products-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Our products</p>
        <h2 id="products-h">We build our own products too</h2>
        <p class="lead">Running our own software keeps us honest about what it takes to keep a product working, and that experience goes into every client build.</p>
      </div>
      <div class="products">
        <article class="glass">
          <div class="logo-tile"><Image src={solak} alt="Solak logo" width={240} class="product-logo" /></div>
          <h3>Solak</h3>
          <p class="muted">Verified attendance and class management for lecturers and students: live check-in, course materials, assignments and announcements in one place. Now in pilot at Kaduna Polytechnic.</p>
        </article>
        <article class="glass">
          <div class="logo-tile"><Image src={smartWriter} alt="Smart Writer logo" width={420} class="product-logo" /></div>
          <h3>Smart Writer</h3>
          <p class="muted">An AI assistant for academic writing, in development.</p>
        </article>
        <article class="glass">
          <div class="shot"><Image src={faithnow} alt="FaithNow home page" width={640} quality={78} /></div>
          <h3>FaithNow</h3>
          <p class="muted">Structured faith learning, a community and a resource library, for a new generation.</p>
        </article>
      </div>
    </div>
  </section>

  <section id="tech-talk" class="section section--raised" aria-labelledby="tt-h">
    <div class="wrap two">
      <div class="tt-title">
        <span class="icon-tile"><Icon name="training" size={30} /></span>
        <h2 id="tt-h">Tech Talk academy</h2>
      </div>
      <div class="prose">
        <p class="lead">Our academy in Abuja and Kaduna teaches practical, in-demand tech skills to students and young professionals.</p>
        <p class="muted">It also helps us find and train the people who build for our clients.</p>
        <a class="btn btn--ghost" href="/contact/?service=tech-talk">Ask about the next cohort <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="promise-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Our promise</p>
        <h2 id="promise-h">How we work with you</h2>
      </div>
      <ul class="promises">
        {promises.map((p) => <li class="glass"><h3>{p.title}</h3><p class="muted">{p.text}</p></li>)}
      </ul>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .mark-grid { display: grid; gap: 48px; align-items: center; }
  @media (min-width: 900px) { .mark-grid { grid-template-columns: 1fr 1.4fr; gap: 80px; } }
  .mark-art { position: relative; display: grid; place-items: center; min-height: 300px; }
  .mark-art img { position: relative; width: min(300px, 80%); height: auto; }
  .mark-orb { left: 50%; top: 50%; width: 360px; height: 360px; margin: -180px 0 0 -180px; background: radial-gradient(closest-side, rgba(22, 96, 214, 0.55), rgba(5, 15, 34, 0)); }
  .prose { display: grid; gap: 18px; max-width: 64ch; justify-items: start; }

  .team { list-style: none; margin: 0; padding: 0; display: grid; gap: 32px 20px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 1000px) { .team { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .team li { display: grid; gap: 4px; align-content: start; }
  .photo-wrap { border-radius: 18px; overflow: hidden; border: 1px solid var(--line); margin-bottom: 14px; background: var(--panel); }
  .team :global(.photo) { width: 100%; aspect-ratio: 6 / 7; height: auto; object-fit: cover; object-position: 50% 15%; }
  .team h3 { font-size: var(--step-1); }

  .products { display: grid; gap: 20px; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); }
  .products article { padding: 24px; display: grid; gap: 12px; align-content: start; }
  .logo-tile { height: 160px; border-radius: 12px; background: #FFFFFF; display: grid; place-items: center; padding: 24px; margin-bottom: 8px; }
  .logo-tile :global(.product-logo) { max-height: 72px; width: auto; object-fit: contain; }
  .shot { height: 160px; border-radius: 12px; overflow: hidden; margin-bottom: 8px; }
  .shot :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: top left; }

  .two { display: grid; gap: 24px; }
  @media (min-width: 900px) { .two { grid-template-columns: 1fr 1.6fr; gap: 80px; } }
  .tt-title { display: grid; gap: 20px; align-content: start; justify-items: start; }
  .icon-tile { width: 60px; height: 60px; border-radius: 14px; display: grid; place-items: center; background: rgba(22, 96, 214, 0.25); border: 1px solid rgba(79, 143, 245, 0.5); }

  .promises { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); }
  .promises li { padding: 28px 24px; display: grid; gap: 8px; align-content: start; }
  .promises h3 { font-size: var(--step-1); }
</style>
