---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { company } from '../data/site';
import victor from '../assets/team/victor-uzorchikwa.jpg';
import samuel from '../assets/team/samuel-ikediashi.jpg';
import gideon from '../assets/team/gideon-onuh.jpg';
import ebonom from '../assets/team/ebonom-agam.jpg';
import solak from '../assets/products/solak.png';
import smartWriter from '../assets/products/smart-writer.png';
import faithnow from '../assets/work/faithnow-desk.webp';

const team = [
  { name: 'Victor Uzorchikwa', role: 'Co-founder and CEO', img: victor },
  { name: 'Samuel Ikediashi', role: 'Co-founder and Creative Director', img: samuel },
  { name: 'Gideon Onuh', role: 'Human Resources', img: gideon },
  { name: 'Ebonom Agam, Esq.', role: 'Legal Partner', img: ebonom },
];

const promises = [
  { title: 'Clear, not clever', text: 'Plain words about what we will build, when, and what it costs.' },
  { title: 'Proof, not hype', text: 'We show work and results instead of adjectives.' },
  { title: 'Results, not jargon', text: 'We talk about what changes for your business, not the technology behind it.' },
  { title: 'Partners, not vendors', text: 'We stay after launch and keep improving what we built with you.' },
];
---
<Base title="About" description="Soma Concepts is an Abuja-based technology company that builds and runs the digital side of growing businesses. Meet the team, our products and the Tech Talk academy.">
  <section class="page-head">
    <div class="glow breathe" aria-hidden="true"></div>
    <div class="wrap head-grid">
      <div class="head-copy">
        <p class="eyebrow">About Soma</p>
        <h1>A technology company <span class="accent">from Abuja.</span></h1>
        <p class="lead">{company.name} started in {company.founded} to give growing Nigerian businesses one dependable partner for their apps, websites, automation and marketing. We have served {company.clientsServed} clients so far, from real estate to travel and logistics.</p>
      </div>
      <div class="head-mark floaty" aria-hidden="true">
        <div class="glow breathe"></div>
        <img src="/brand/soma-mark-reversed.svg" alt="" width="220" height="220" />
      </div>
    </div>
  </section>

  <section class="section mark" aria-labelledby="mark-h">
    <div class="wrap two">
      <h2 id="mark-h">What our mark means</h2>
      <p class="lead">Four bands locked into one square. Each band is a part of a business: its apps, its website, its operations and its marketing. The blue corners lock them together, the way we connect them for our clients. The square is the promise: built to last.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="team-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">The team</p>
        <h2 id="team-h">The people behind Soma</h2>
        <p class="lead">A compact leadership team, backed by developers, designers, video editors and content creators.</p>
      </div>
      <ul class="team">
        {team.map((p) => (
          <li>
            <div class="photo-frame"><Image src={p.img} alt={`Portrait of ${p.name}`} width={480} height={560} quality={78} class="photo" /></div>
            <h3>{p.name}</h3>
            <p class="muted">{p.role}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="products-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Our products</p>
        <h2 id="products-h">We build our own products too</h2>
        <p class="lead">Running our own software keeps us honest about what it takes to keep a product working, and that experience goes into every client build.</p>
      </div>
      <div class="products">
        <article class="glass">
          <div class="logo-tile"><Image src={solak} alt="Solak logo" width={240} class="product-logo" /></div>
          <h3>Solak</h3>
          <p class="muted">Verified attendance and class management for lecturers and students: live check-in, course materials, assignments and announcements in one place. Now in pilot at Kaduna Polytechnic.</p>
        </article>
        <article class="glass">
          <div class="logo-tile"><Image src={smartWriter} alt="Smart Writer logo" width={420} class="product-logo" /></div>
          <h3>Smart Writer</h3>
          <p class="muted">An AI assistant for academic writing, in development.</p>
        </article>
        <article class="glass">
          <div class="logo-tile logo-tile--shot"><Image src={faithnow} alt="FaithNow home page" widths={[480, 720]} sizes="360px" class="product-shot" /></div>
          <h3>FaithNow</h3>
          <p class="muted">Structured biblical training and a community to grow with, open anytime, anywhere.</p>
        </article>
      </div>
    </div>
  </section>

  <section id="tech-talk" class="section" aria-labelledby="tt-h">
    <div class="wrap">
      <div class="tt glass">
        <div class="glow breathe" aria-hidden="true"></div>
        <div class="tt-title">
          <span class="tt-icon"><Icon name="training" size={32} /></span>
          <h2 id="tt-h">Tech Talk academy</h2>
        </div>
        <div class="prose">
          <p class="lead">Our academy in Abuja and Kaduna teaches practical, in-demand tech skills to students and young professionals.</p>
          <p class="muted">It also helps us find and train the people who build for our clients.</p>
          <a class="btn btn--cyan" href="/contact/?service=tech-talk">Ask about the next cohort <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="promise-h">
    <div class="wrap">
      <h2 id="promise-h" class="promise-title">How we work with you</h2>
      <ul class="promises">
        {promises.map((p) => <li class="glass"><span class="node" aria-hidden="true"></span><h3>{p.title}</h3><p class="muted">{p.text}</p></li>)}
      </ul>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .head-grid { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 900px) { .head-grid { grid-template-columns: 1fr 260px; gap: 80px; } }
  .head-copy { display: grid; gap: 20px; }
  .head-mark { position: relative; width: 160px; }
  @media (min-width: 900px) { .head-mark { width: 240px; } }
  .head-mark .glow { inset: -45%; }
  .head-mark img { position: relative; width: 100%; height: auto; }

  .mark { padding-top: 0; }
  .two { display: grid; gap: 20px; }
  @media (min-width: 900px) { .two { grid-template-columns: 1fr 1.6fr; gap: 80px; align-items: start; } }

  .team { list-style: none; margin: 0; padding: 0; display: grid; gap: 32px 20px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 1000px) { .team { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .team li { display: grid; gap: 4px; align-content: start; }
  .photo-frame { border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line); margin-bottom: 14px; box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35); }
  .photo-frame :global(.photo) { width: 100%; aspect-ratio: 6 / 7; height: auto; object-fit: cover; object-position: 50% 15%; background: var(--night-2); }
  .team h3 { font-size: var(--step-1); }

  .products { display: grid; gap: 20px; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); }
  .products article { padding: 24px; border-radius: var(--radius-lg); display: grid; gap: 12px; align-content: start; }
  .logo-tile { height: 160px; border-radius: 14px; background: #FFFFFF; display: grid; place-items: center; padding: 24px; margin-bottom: 8px; overflow: hidden; }
  .logo-tile--shot { padding: 0; background: #0B2545; }
  .products :global(.product-logo) { max-height: 88px; width: auto; object-fit: contain; }
  .products :global(.product-shot) { width: 100%; height: 100%; object-fit: cover; object-position: top left; }

  .tt { position: relative; overflow: hidden; isolation: isolate; display: grid; gap: 28px; padding: 40px 28px; border-radius: var(--radius-lg); }
  @media (min-width: 900px) { .tt { grid-template-columns: 1fr 1.4fr; gap: 64px; padding: 56px; } }
  .tt .glow { right: -20%; top: -60%; width: 70%; height: 200%; z-index: -1; }
  .tt-title { display: grid; gap: 20px; align-content: start; }
  .tt-icon { width: 64px; height: 64px; border-radius: 50%; display: grid; place-items: center; background: rgba(22, 96, 214, 0.35); box-shadow: inset 0 0 0 1px rgba(79, 143, 245, 0.6); }
  .prose { display: grid; gap: 18px; justify-items: start; }

  .promise-title { margin-bottom: 32px; }
  .promises { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); }
  .promises li { padding: 26px 24px; border-radius: var(--radius); display: grid; gap: 10px; align-content: start; }
  .promises .node { box-shadow: 0 0 10px rgba(43, 179, 240, 0.7); }
</style>
