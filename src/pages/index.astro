---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import FlowLines from '../components/FlowLines.astro';
import Phone from '../components/Phone.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { company, services, process, testimonials } from '../data/site';
import { projects, clientNames } from '../data/projects';
import victor from '../assets/team/victor-uzorchikwa.jpg';
import samuel from '../assets/team/samuel-ikediashi.jpg';
import gideon from '../assets/team/gideon-onuh.jpg';
import nonimedia from '../assets/work/nonimedia.jpg';
import crixux from '../assets/work/crixux.jpg';
import faithnow from '../assets/work/faithnow.jpg';
import airgoPhone from '../assets/work/airgo-phone.jpg';
import crixuxPhone from '../assets/work/crixux-phone.jpg';

const featured = ['airgo', 'nonimedia', 'soluxe', 'crixux', 'megavolt', 'inspiringteens']
  .map((id) => projects.find((p) => p.id === id)!)
  .filter(Boolean);
const ownProducts = 3; // Solak, Smart Writer and FaithNow
---
<Base description="Soma Concepts builds and runs mobile apps, websites, business automation, brand strategy and ads for growing businesses in Nigeria. Based in Abuja.">

  <section class="hero">
    <FlowLines variant="hero" />
    <span class="spark twinkle" style="left: 47%; top: 62%;" aria-hidden="true"></span>
    <span class="spark twinkle-2" style="left: 6%; top: 14%;" aria-hidden="true"></span>
    <span class="spark twinkle-3" style="left: 94%; top: 86%;" aria-hidden="true"></span>

    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1 class="rise">Software that keeps your business <span class="ring">moving.<svg viewBox="0 0 300 110" preserveAspectRatio="none" aria-hidden="true"><path d="M150 8 C 260 4, 298 38, 290 62 C 280 96, 160 106, 70 100 C 12 96, -4 70, 10 46 C 26 18, 110 6, 190 10" fill="none" stroke="#2BB3F0" stroke-width="3" stroke-linecap="round" vector-effect="non-scaling-stroke" /></svg></span></h1>
        <p class="lead rise-2">Apps, websites, automation and marketing for growing Nigerian businesses. We build it, launch it, and keep it running.</p>
        <div class="hero-actions rise-3">
          <a class="btn btn--primary" href="/contact/">Start a project <span class="arrow" aria-hidden="true">→</span></a>
          <div class="team-chip">
            <div class="faces">
              <Image src={victor} alt="Victor Uzorchikwa" width={80} height={80} quality={80} />
              <Image src={samuel} alt="Samuel Ikediashi" width={80} height={80} quality={80} />
              <Image src={gideon} alt="Gideon Onuh" width={80} height={80} quality={80} />
            </div>
            <span>Built by a team<br />in {company.city}</span>
          </div>
        </div>
      </div>

      <div class="stack" aria-label="Some of our live work">
        <div class="orb breathe stack-orb" aria-hidden="true"></div>
        <div class="screen s1 float-3"><div class="tilt"><Image src={faithnow} alt="FaithNow learning platform" width={760} quality={76} loading="eager" /></div></div>
        <div class="screen s2 float-2"><div class="tilt"><Image src={crixux} alt="CRIXUX INTERBIZ app demo" width={760} quality={76} loading="eager" /></div></div>
        <div class="screen s3 float"><div class="tilt"><Image src={nonimedia} alt="Nonimedia Production Concept website" width={760} quality={80} loading="eager" /></div></div>
      </div>
    </div>
  </section>

  <section class="proof" aria-label="Soma in numbers">
    <div class="wrap">
      <dl class="stats glass">
        <div><dt>Clients served</dt><dd>{company.clientsServed}</dd></div>
        <div><dt>Services, one team</dt><dd>{services.length}</dd></div>
        <div><dt>Products of our own</dt><dd>{ownProducts}</dd></div>
        <div><dt>Founded in {company.city}</dt><dd>{company.founded}</dd></div>
      </dl>
      <ul class="clients" aria-label="Clients we have built for">
        {clientNames.map((n) => <li>{n}</li>)}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="work-heading">
    <div class="wrap">
      <div class="work-head">
        <div class="section-head">
          <p class="eyebrow">Our work</p>
          <h2 id="work-heading">Live products, not mockups.</h2>
          <p class="lead">Every screen here is running today for a real business. Open any of them and try it.</p>
        </div>
        <a class="btn btn--ghost" href="/work/">See all work <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <div class="work-grid">
        {featured.map((p) => <ProjectCard project={p} />)}
      </div>
    </div>
  </section>

  <section class="section section--raised" aria-labelledby="services-heading">
    <div class="wrap">
      <div class="section-head section-head--center">
        <p class="eyebrow">What we do</p>
        <h2 id="services-heading">What we build for you</h2>
        <p class="lead">Five services, one team. Use one, or let us handle the whole journey from first screen to first customer.</p>
      </div>
      <ul class="services">
        {services.map((s) => (
          <li>
            <span class="icon-tile"><Icon name={s.icon} size={26} /></span>
            <h3><a href={`/services/#${s.id}`}>{s.name}</a></h3>
            <p>{s.summary}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section after" aria-labelledby="after-heading">
    <FlowLines variant="down" />
    <div class="wrap after-grid">
      <div class="after-copy">
        <p class="eyebrow">After launch</p>
        <h2 id="after-heading">We don't hand over and disappear.</h2>
        <p class="lead">We host, fix and improve what we build, the same way we run our own products every day. One team knows your system from the first screen to the latest update.</p>
        <ul class="nodes">
          <li><strong>You approve every screen</strong> before we write code.</li>
          <li><strong>We test on real phones</strong> and show progress as we go.</li>
          <li><strong>We stay on</strong> for hosting, fixes and new features.</li>
        </ul>
        <div class="btn-row"><a class="btn btn--primary" href="/contact/">Start a project <span class="arrow" aria-hidden="true">→</span></a></div>
      </div>
      <div class="phones">
        <div class="orb breathe phones-orb" aria-hidden="true"></div>
        <div class="p1 float-2"><Phone src={crixuxPhone} alt="CRIXUX app on a phone" tilt={-8} width={300} /></div>
        <div class="p2 float"><Phone src={airgoPhone} alt="Airgo app on a phone" tilt={6} glow width={300} /></div>
      </div>
    </div>
  </section>

  <section class="section section--raised" aria-labelledby="process-heading">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">How a project runs</p>
        <h2 id="process-heading">Clear steps, agreed dates.</h2>
        <p class="lead">Typical times for a website or a first app. Larger platforms take longer, and we agree the dates with you up front.</p>
      </div>
      <ol class="steps">
        {process.map((p, i) => (
          <li class="glass">
            <span class="step-num" aria-hidden="true">0{i + 1}</span>
            <h3>{p.name}</h3>
            <p class="time">{p.time}</p>
            <p class="muted">{p.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="clients-heading">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Clients</p>
        <h2 id="clients-heading">What clients say</h2>
      </div>
      <div class="quotes">
        {testimonials.map((t) => (
          <figure class="glass">
            <svg class="qmark" width="36" height="28" viewBox="0 0 36 28" aria-hidden="true"><path d="M0 28V16C0 7 5 1.5 14 0l1.5 4C10 5.6 7.6 9 7.4 13H14v15H0Zm20 0V16C20 7 25 1.5 34 0l1.5 4C30 5.6 27.6 9 27.4 13H34v15H20Z" fill="#2BB3F0" /></svg>
            <blockquote><p>{t.quote}</p></blockquote>
            <figcaption><strong>{t.who}</strong><span>{t.role}</span></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  /* Hero */
  .hero { position: relative; overflow: hidden; padding-block: 56px 32px; }
  @media (min-width: 1000px) { .hero { padding-block: 96px 104px; } }
  .hero-grid { display: grid; gap: 48px; align-items: center; }
  @media (min-width: 1000px) { .hero-grid { grid-template-columns: 1fr 1.05fr; gap: 56px; } }
  .hero-copy { display: grid; gap: 26px; position: relative; z-index: 2; }
  .hero h1 { max-width: 13ch; }
  .ring { position: relative; display: inline-block; padding: 0 10px; color: var(--cyan); }
  .ring svg { position: absolute; left: -6px; top: -8px; width: calc(100% + 12px); height: calc(100% + 16px); overflow: visible; }
  .hero-actions { display: flex; align-items: center; gap: 24px; flex-wrap: wrap; }
  .team-chip { display: flex; align-items: center; gap: 12px; font-size: 14px; line-height: 1.35; color: var(--muted); }
  .faces { display: flex; }
  .faces :global(img) { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; object-position: 50% 20%; border: 2px solid var(--bg); }
  .faces :global(img + img) { margin-left: -10px; }

  .stack { position: relative; aspect-ratio: 1 / 0.86; width: 100%; max-width: 620px; justify-self: center; }
  .stack-orb { right: -6%; top: 0; width: 68%; aspect-ratio: 1; background: radial-gradient(circle at 40% 35%, #4F8FF5, #1660D6 55%, #0B3A86 100%); box-shadow: 0 0 120px 30px rgba(22, 96, 214, 0.45); }
  .screen { position: absolute; width: 78%; }
  .tilt { transform: perspective(1200px) rotateY(-14deg) rotateZ(4deg); border-radius: 16px; overflow: hidden; border: 1px solid rgba(255, 255, 255, 0.2); box-shadow: 0 30px 70px rgba(0, 0, 0, 0.55); }
  .tilt :global(img) { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; object-position: top left; }
  .s1 { left: 0; top: 0; opacity: 0.7; }
  .s2 { left: 8%; top: 22%; opacity: 0.9; }
  .s3 { left: 16%; top: 44%; }
  .s3 .tilt { border-color: rgba(43, 179, 240, 0.6); box-shadow: 0 40px 90px rgba(0, 0, 0, 0.65), 0 0 50px rgba(43, 179, 240, 0.25); }

  /* Proof */
  .proof { position: relative; padding-block: 32px 24px; }
  .stats { margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 8px; padding: 28px 16px; }
  @media (min-width: 800px) { .stats { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .stats div { display: flex; flex-direction: column-reverse; align-items: center; gap: 4px; text-align: center; }
  .stats dd { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: 44px; line-height: 1; }
  .stats dt { font-size: 14px; color: var(--muted); }
  .clients { list-style: none; margin: 0; padding: 40px 0 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 14px 44px; font-family: var(--font-display); font-weight: 600; font-size: 20px; color: var(--dim); }

  /* Work */
  .work-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; margin-bottom: 40px; }
  .work-head .section-head { margin-bottom: 0; }
  .work-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: 20px; }

  /* Services */
  .services { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr)); gap: 32px 28px; }
  .services li { display: grid; gap: 12px; align-content: start; }
  .icon-tile { width: 52px; height: 52px; border-radius: 12px; display: grid; place-items: center; background: rgba(22, 96, 214, 0.25); border: 1px solid rgba(79, 143, 245, 0.5); box-shadow: 0 0 24px rgba(22, 96, 214, 0.25); }
  .services h3 { font-size: 20px; }
  .services h3 a { color: #FFFFFF; text-decoration: none; }
  .services h3 a:hover { color: var(--cyan); }
  .services p { font-size: 15px; line-height: 1.55; color: var(--muted); }

  /* After launch */
  .after { overflow: hidden; }
  .after-grid { display: grid; gap: 56px; align-items: center; }
  @media (min-width: 1000px) { .after-grid { grid-template-columns: 1fr 1fr; } }
  .after-copy { display: grid; gap: 20px; justify-items: start; position: relative; z-index: 1; }
  .phones { position: relative; min-height: 460px; width: 100%; max-width: 520px; justify-self: center; }
  @media (min-width: 600px) { .phones { min-height: 540px; } }
  .phones-orb { left: 50%; top: 50%; width: 380px; height: 380px; margin: -190px 0 0 -190px; background: radial-gradient(closest-side, rgba(22, 96, 214, 0.75), rgba(22, 96, 214, 0.15) 70%, rgba(5, 15, 34, 0)); }
  .p1 { position: absolute; left: 10%; top: 40px; width: 40%; }
  .p2 { position: absolute; right: 8%; top: 0; width: 42%; }

  /* Steps */
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); }
  .steps li { display: grid; gap: 8px; align-content: start; padding: 28px 24px; }
  .step-num { font-family: var(--font-display); font-weight: 700; font-size: 40px; line-height: 1; color: var(--blue-2); }
  .time { font-size: var(--step--1); font-weight: 600; color: var(--cyan); }
  .steps .muted { font-size: 15px; }

  /* Quotes */
  .quotes { display: grid; gap: 20px; }
  @media (min-width: 900px) { .quotes { grid-template-columns: 1fr 1fr; } }
  figure { margin: 0; padding: 32px; display: grid; gap: 20px; align-content: start; }
  blockquote { margin: 0; font-size: var(--step-1); line-height: 1.6; }
  figcaption { display: grid; gap: 2px; font-size: var(--step--1); margin-top: auto; }
  figcaption span { color: var(--muted); }
</style>
