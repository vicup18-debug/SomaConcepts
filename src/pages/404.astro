---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page does not exist on the Soma Concepts website.">
  <section class="section nf-section">
    <div class="glow breathe" aria-hidden="true"></div>
    <div class="wrap nf">
      <img class="floaty" src="/brand/soma-mark-reversed.svg" alt="" width="120" height="120" />
      <h1>This page doesn't exist</h1>
      <p class="lead">The link may be old or mistyped. Start from the home page, or tell us what you were looking for.</p>
      <div class="btn-row">
        <a class="btn btn--primary" href="/">Go to the home page</a>
        <a class="btn btn--outline" href="/contact/">Contact us</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf-section { overflow: hidden; }
  .nf-section > .glow { left: 20%; top: -10%; width: 60%; height: 120%; }
  .nf { position: relative; display: grid; gap: 24px; justify-items: center; text-align: center; min-height: 55vh; align-content: center; }
  .nf h1 { font-size: clamp(2.25rem, 1.4rem + 3.4vw, 4rem); }
</style>
